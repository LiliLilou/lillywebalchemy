---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Start an experiment" description="Get in touch with Lilly about a role or a project." current="contact">
  <section class="contact">
    <div style="display:flex;flex-direction:column;gap:20px">
      <p class="eyebrow">// new experiment</p>
      <h1 class="display">Start an experiment</h1>
      <p class="lead">
        Hiring for a front-end or WordPress role, or have a project in mind? Write to me, I usually reply within a day.
      </p>
      <ul class="contact-links">
        <li><a href={`mailto:${site.email}`}>→ {site.email}</a></li>
        <li><a href={site.linkedin} rel="me">→ LinkedIn</a></li>
        <li><a href={site.github} rel="me">→ {site.github.replace('https://', '')}</a></li>
      </ul>
    </div>

    {
      site.formAction && (
        <form class="terminal" action={site.formAction} method="POST" id="contact-form">
          <div class="terminal-bar">
            <i aria-hidden="true"></i>
            <i aria-hidden="true"></i>
            <i aria-hidden="true"></i>
            <span>~/lab/new-experiment.sh</span>
          </div>
          <div class="terminal-body">
            <div class="field">
              <label for="c-name">$ name</label>
              <input id="c-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="c-email">$ email</label>
              <input id="c-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="c-type">$ type</label>
              <select id="c-type" name="type">
                <option>Job opportunity</option>
                <option>Project</option>
                <option>Just saying hi</option>
              </select>
            </div>
            <div class="field">
              <label for="c-msg">$ message</label>
              <textarea id="c-msg" name="message" rows="5" required></textarea>
            </div>
            <button class="btn" type="submit">./run →</button>
            <p class="note" id="form-status" role="status"></p>
          </div>
        </form>
      )
    }
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (status) status.textContent = 'compiling…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) status.textContent = 'experiment compiled ✓ talk soon';
    } catch {
      if (status) status.textContent = '✕ something broke. Please email me directly.';
    }
  });
</script>
